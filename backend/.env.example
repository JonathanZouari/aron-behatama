# --- סביבה כללית ---
# development | production
APP_ENV=development
PORT=5000
# true = דמו מקומי עם SQLite וסוכן AI מדומה (חסום כאשר APP_ENV=production)
DEMO_MODE=true
# נתיב קובץ SQLite לדמו (ברירת מחדל: backend/data/demo.sqlite3, ":memory:" לבדיקות)
SQLITE_PATH=data/demo.sqlite3
# סוד לחתימת session cookies של לקוחות — חובה ערך אקראי ארוך בפריסה
SESSION_SECRET=change-me-to-a-long-random-string
# origin של ה-Frontend (משמש לבדיקת Origin בבקשות state-changing). ריק = דילוג בפיתוח בלבד
FRONTEND_ORIGIN=

# --- Supabase (נדרש כאשר DEMO_MODE=false) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# חיבור ישיר ל-PostgreSQL של Supabase (Session pooler, פורט 5432). השרת עובד עם service role ומבצע בדיקות הרשאה בעצמו
DATABASE_URL=
# משמש לאימות JWT של הנגר. אם ריק, האימות נעשה דרך JWKS של הפרויקט
SUPABASE_JWT_SECRET=

# --- OpenAI (נדרש כאשר DEMO_MODE=false) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# false = להשתמש בסוכן מדומה גם מחוץ לדמו (למשל אם אין מפתח)
AI_ENABLED=true
