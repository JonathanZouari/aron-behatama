# פורט ההאזנה (Railway מגדיר אוטומטית)
PORT=3000
# כתובת ה-Backend של אותה סביבה. בדפדפן הבקשות הולכות ל-/api באותו origin והשרת מעביר אותן לכאן.
# מקומי: http://localhost:5000  | Railway: כתובת פרטית/ציבורית של שירות ה-backend באותה סביבה
BACKEND_URL=http://localhost:5000
# הגדרות Supabase ציבוריות (anon) — משמשות בדפדפן רק להתחברות הנגר. ריק = מצב דמו
SUPABASE_URL=
SUPABASE_ANON_KEY=
# development | production — מוצג כתגית בממשק הנגר
APP_ENV=development
